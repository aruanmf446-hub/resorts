{
  "name": "the-world-beyond",
  "version": "1.0.0",
  "private": true,
  "description": "THE WORLD BEYOND \u2014 Resort Experience 2026. White-label immersive resort website template (Astro + Three.js + GSAP).",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "dev:coastal": "RESORT_PRESET=coastal astro dev",
    "dev:mountain": "RESORT_PRESET=mountain astro dev",
    "dev:wellness": "RESORT_PRESET=wellness astro dev",
    "build:coastal": "RESORT_PRESET=coastal astro build --outDir dist/coastal",
    "build:mountain": "RESORT_PRESET=mountain astro build --outDir dist/mountain",
    "build:wellness": "RESORT_PRESET=wellness astro build --outDir dist/wellness",
    "build:all": "npm run build:coastal && npm run build:mountain && npm run build:wellness",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "node tests/e2e.mjs",
    "test": "npm run test:unit && npm run build:all && npm run test:e2e",
    "assets:art": "node scripts/generate-art.mjs",
    "assets:renders": "node scripts/generate-renders.mjs",
    "assets:glb": "node scripts/generate-glb.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "astro": "^5.18.2",
    "gsap": "^3.15.1",
    "simplex-noise": "^4.0.3",
    "three": "^0.187.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
