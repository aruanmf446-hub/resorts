---
import '../styles/fonts.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import Footer from '../components/Footer.astro';
import BookingDrawer from '../components/BookingDrawer.astro';
import { site, t } from '../lib/context';
import { themeCss, themeAttrs } from '../lib/theme';

interface Props { title?: string; description?: string; image?: string; jsonLd?: Record<string, unknown>[]; noindex?: boolean; pageId?: string; heroOverlay?: boolean }
const { pageId, heroOverlay = false, ...seo } = Astro.props;
const attrs = themeAttrs(site.theme);
const ga = site.integrations.ga4;
---
<!doctype html>
<html lang={site.locale} {...attrs} data-page={pageId} data-overlay={String(heroOverlay)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={site.theme.colors.dark} />
    <meta name="generator" content="THE WORLD BEYOND — Resort Experience 2026" />
    <Seo {...seo} />
    <style is:inline set:html={themeCss(site.theme)}></style>
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce && d.dataset.motion !== 'none') {
          d.classList.add('motion-ready');
          // Safety net: never leave content hidden if the motion bundle fails.
          setTimeout(function () { if (!window.__motion) d.classList.remove('motion-ready'); }, 3500);
        }
      })();
    </script>
    {ga && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>
        <script is:inline define:vars={{ ga }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga, { anonymize_ip: true });
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Header pageId={pageId} />
    <Menu pageId={pageId} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <BookingDrawer />
    <script>
      import '../scripts/motion';
      import '../scripts/site';
    </script>
  </body>
</html>
