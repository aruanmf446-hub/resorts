---
import type { Stay, SectionConfig } from '../config/schema';
import Base from '../layouts/Base.astro';
import Sections from './Sections.astro';
import Img from './Img.astro';
import { site, t, link, bookingEnabled, bookingHref } from '../lib/context';
import { rich } from '../lib/sections';
interface Props { stay: Stay }
const { stay } = Astro.props;
const sec = (s: Partial<SectionConfig> & { type: SectionConfig['type'] }): SectionConfig => ({ enabled: true, content: {}, assets: {}, animation: 'auto', ...s });
const extra: SectionConfig[] = [];
if (stay.gallery.length >= 3) extra.push(sec({ type: 'gallery', id: 'stay-gallery', content: { eyebrow: t('gallery'), title: stay.name, images: stay.gallery } }));
if (stay.tour360) extra.push(sec({ type: 'virtualTour', id: 'stay-360', theme: 'dark', content: { eyebrow: t('tour360'), title: stay.tour360.label, panorama: stay.tour360.image, fallback: stay.cover, label: stay.tour360.label } }));
if (stay.model) extra.push(sec({ type: 'villaExplorer', id: 'stay-3d', theme: 'dark', content: { eyebrow: t('model3d'), title: stay.name, stay: stay.slug } }));
const mapHref = stay.poi ? link.resolve(`poi:${stay.poi}`) : null;
const related = site.stays.filter((s) => s.slug !== stay.slug).slice(0, 3);
const pageUrl = new URL(Astro.url.pathname, site.seo.siteUrl).toString();
const stays = site.pages.find((p) => p.id === 'stays' && p.enabled);
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'HotelRoom', name: stay.name, description: stay.description[0], image: new URL(stay.cover.src, site.seo.siteUrl).toString(), url: pageUrl,
    occupancy: { '@type': 'QuantitativeValue', maxValue: stay.capacity.adults + stay.capacity.children },
    ...(stay.area && { floorSize: { '@type': 'QuantitativeValue', value: stay.area.value, unitCode: stay.area.unit === 'm²' ? 'MTK' : 'FTK' } }),
    amenityFeature: stay.amenities.map((a) => ({ '@type': 'LocationFeatureSpecification', name: a, value: true })),
    containedInPlace: { '@type': 'Resort', name: site.identity.name, url: site.seo.siteUrl } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('home'), item: site.seo.siteUrl },
    ...(stays ? [{ '@type': 'ListItem', position: 2, name: stays.title, item: new URL(link.page('stays')!, site.seo.siteUrl).toString() }] : []),
    { '@type': 'ListItem', position: stays ? 3 : 2, name: stay.name, item: pageUrl },
  ] },
];
---
<Base title={stay.name} description={stay.tagline} image={stay.cover.src} pageId="stays" heroOverlay jsonLd={jsonLd}>
  <section class="sd-hero" data-theme="dark">
    <div class="sd-hero__media media" data-reveal="mask" data-start="top 100%"><div class="sd-hero__par" data-parallax="0.16"><Img image={stay.cover} eager /></div></div>
    <div class="sd-hero__scrim" aria-hidden="true"></div>
    <div class="wrap sd-hero__content">
      {stays && <a class="micro sd-back link" href={link.page('stays')}>← {stays.title}</a>}
      <p class="eyebrow" data-reveal="fade" data-start="top 100%">{stay.category}</p>
      <h1 class="t-mega" data-reveal="lines" data-start="top 100%">{stay.name}</h1>
      <p class="lede" data-reveal="fade" data-delay="0.4" data-start="top 100%">{stay.tagline}</p>
    </div>
  </section>

  <section class="section sd-body" data-theme="light">
    <div class="wrap grid">
      <dl class="sd-facts" data-reveal="stagger">
        <div><dt class="micro muted">{t('capacity')}</dt><dd class="t-m num">{stay.capacity.label ?? `${stay.capacity.adults}${stay.capacity.children ? ` + ${stay.capacity.children}` : ''}`}</dd></div>
        {stay.area && <div><dt class="micro muted">{t('area')}</dt><dd class="t-m num">{stay.area.value} {stay.area.unit}</dd></div>}
        {stay.view && <div><dt class="micro muted">{t('view')}</dt><dd class="t-m">{stay.view}</dd></div>}
        <div class="sd-facts__cta">
          {bookingEnabled && bookingHref && <a class="btn" href={stay.bookingUrl && site.booking.mode === 'direct' ? stay.bookingUrl : bookingHref} data-book-open={site.booking.mode === 'direct' ? undefined : ''} data-stay={stay.slug}><span>{site.booking.label}</span><span class="btn__arrow" aria-hidden="true"></span></a>}
        </div>
      </dl>
      <div class="sd-story prose">
        {stay.description.map((p, i) => <p class={i === 0 ? 'lede' : ''} data-reveal="fade">{p}</p>)}
        {mapHref && <a class="btn btn--ghost" href={mapHref}><span>{t('onTheMap')}</span><span class="btn__arrow" aria-hidden="true"></span></a>}
      </div>
      {stay.amenities.length > 0 && (
        <div class="sd-amen">
          <h2 class="micro muted">{t('amenities')}</h2>
          <ul role="list" data-reveal="stagger">{stay.amenities.map((a) => <li>{a}</li>)}</ul>
        </div>
      )}
      {stay.floorplan && (
        <figure class="sd-plan">
          <div class="media sd-plan__img"><Img image={stay.floorplan.image} /></div>
          <figcaption>{t('floorplan')} — {stay.floorplan.note}</figcaption>
        </figure>
      )}
    </div>
  </section>

  {stay.video && (
    <section class="section" data-theme="dark"><div class="wrap"><div class="media" style="aspect-ratio:16/9"><video controls playsinline preload="none" poster={stay.video.poster.src} aria-label={stay.video.label}><source src={stay.video.src} type="video/mp4" />{stay.video.captions && <track kind="captions" src={stay.video.captions} default />}</video></div></div></section>
  )}

  <Sections sections={extra} />

  {related.length > 0 && (
    <section class="section" data-theme="alt">
      <div class="wrap sd-rel">
        <h2 class="t-l" set:html={rich(t('related'))} />
        <ul role="list" class="sd-rel__list">
          {related.map((s) => <li><a href={link.stay(s.slug)} class="sd-rel__card"><span class="media"><Img image={s.cover} sizes="33vw" /></span><span class="micro muted">{s.category}</span><span class="t-s">{s.name}</span></a></li>)}
        </ul>
      </div>
    </section>
  )}
  <Sections sections={site.templates.stay.after} />
</Base>
<style>
  .sd-hero { position: relative; height: 100svh; min-height: 600px; display: grid; color: #fbf8f2; overflow: hidden; background: var(--c-dark); }
  .sd-hero__media { position: absolute; inset: 0; border-radius: 0; }
  .sd-hero__par { position: absolute; inset: -10% 0; }
  .sd-hero__par :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .sd-hero__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(0 0 0 / 0.35), transparent 30%, transparent 50%, rgb(0 0 0 / 0.6)); }
  .sd-hero__content { position: relative; align-self: end; padding-bottom: clamp(80px, 12vh, 140px); display: grid; gap: 20px; }
  .sd-hero .lede { color: rgb(255 255 255 / 0.86); }
  .sd-back { justify-self: start; letter-spacing: 0.18em; }
  .sd-body .grid { row-gap: clamp(48px, 6vw, 96px); }
  .sd-facts { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 32px clamp(32px, 6vw, 96px); align-items: end; border-bottom: 1px solid var(--c-line); padding-bottom: 36px; }
  .sd-facts dd { margin-top: 8px; }
  .sd-facts__cta { margin-left: auto; }
  .sd-story { grid-column: 1 / span 7; display: grid; gap: 22px; justify-items: start; }
  .sd-amen { grid-column: 9 / -1; }
  .sd-amen ul { margin-top: 16px; }
  .sd-amen li { padding: 12px 0; border-bottom: 1px solid var(--c-line); }
  .sd-plan { grid-column: 1 / -1; margin: 0; }
  .sd-plan__img { aspect-ratio: 3 / 2; background: var(--c-bg-alt); max-width: 1100px; }
  .sd-plan__img :global(img) { object-fit: contain; }
  .sd-rel { display: grid; gap: 40px; }
  .sd-rel__list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 32px; }
  .sd-rel__card { display: grid; gap: 8px; }
  .sd-rel__card .media { aspect-ratio: 4 / 3; margin-bottom: 8px; }
  @media (max-width: 900px) { .sd-story, .sd-amen { grid-column: 1 / -1; } .sd-facts__cta { margin-left: 0; } }
</style>
