---
import { site, t, link } from '../lib/context';
import BookingForm from './BookingForm.astro';
---
{site.booking.mode !== 'disabled' && (
  <div class="drawer" id="book" role="dialog" aria-modal="true" aria-labelledby="drawer-title" data-drawer hidden>
    <div class="drawer__veil" data-drawer-close></div>
    <div class="drawer__panel" data-theme="dark">
      <div class="drawer__head">
        <p class="eyebrow">{site.identity.shortName}</p>
        <button type="button" class="drawer__close" data-drawer-close aria-label={t('close')}><span aria-hidden="true">×</span></button>
      </div>
      <h2 id="drawer-title" class="t-l">{site.booking.label}</h2>
      <BookingForm id="drawer-booking" compact />
      {site.booking.offers.length > 0 && (
        <ul class="drawer__offers" role="list">
          {site.booking.offers.map((o) => (
            <li><p class="t-s">{o.title}</p><p class="small muted">{o.summary}</p>{link.resolve(o.cta.href) && <a class="link small" href={link.resolve(o.cta.href)}>{o.cta.label}</a>}</li>
          ))}
        </ul>
      )}
    </div>
  </div>
)}
<style>
  .drawer { position: fixed; inset: 0; z-index: 1100; }
  .drawer[hidden] { display: none; }
  .drawer__veil { position: absolute; inset: 0; background: rgb(0 0 0 / 0.45); opacity: 0; transition: opacity 0.6s; }
  .drawer.is-open .drawer__veil { opacity: 1; }
  .drawer__panel { position: absolute; top: 0; right: 0; bottom: 0; width: min(560px, 100%); background: var(--c-dark); color: var(--c-dark-ink); padding: clamp(24px, 4vw, 56px); overflow-y: auto; display: grid; align-content: start; gap: 36px; transform: translateX(100%); transition: transform 0.9s var(--ease-glide); }
  .drawer.is-open .drawer__panel { transform: none; }
  .drawer__head { display: flex; justify-content: space-between; align-items: center; }
  .drawer__close { font-size: 2rem; width: 44px; height: 44px; line-height: 1; }
  .drawer__offers { display: grid; gap: 22px; border-top: 1px solid var(--c-line); padding-top: 28px; }
  .drawer__offers li { display: grid; gap: 4px; }
</style>
