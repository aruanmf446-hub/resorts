---
import { site, t, navItems, link, enabledPages, bookingEnabled, bookingHref } from '../lib/context';
import { pageHref } from '../lib/links';
interface Props { pageId?: string }
const { pageId } = Astro.props;
const primary = navItems('primary');
const secondary = navItems('secondary');
const mapPage = enabledPages.find((p) => p.id === 'map');
const spatial = site.theme.nav.mode === 'spatial' && mapPage && site.pois.length > 0;
const home = { id: 'home', label: t('home'), href: '/', image: site.hero.image.src };
const all = [home, ...primary];
---
<div class="menu" id="site-menu" role="dialog" aria-modal="true" aria-label={t('menu')} data-menu hidden>
  <div class="menu__veil" data-menu-close></div>
  <div class="menu__panel">
    <div class="menu__top wrap">
      <span class="menu__brand">{site.identity.wordmark}</span>
      <button type="button" class="menu__close" data-menu-close><span>{t('close')}</span><span class="menu__x" aria-hidden="true"></span></button>
    </div>
    <div class="menu__body wrap">
      <nav class="menu__nav" aria-label={t('menu')}>
        <ol role="list">
          {all.map((i, n) => (
            <li>
              <a href={i.href} data-menu-link data-image={i.image} aria-current={i.id === (pageId ?? 'home') ? 'page' : undefined}>
                <span class="menu__num">{String(n + 1).padStart(2, '0')}</span>
                <span class="menu__label">{i.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <aside class="menu__aside">
        {spatial ? (
          <div class="menu__map">
            <p class="eyebrow">{t('places')}</p>
            <svg viewBox="0 0 100 100" class="menu__svg" role="img" aria-label={t('enterMap')}>
              <circle cx="50" cy="50" r="44" class="menu__land" />
              <circle cx="50" cy="50" r="30" class="menu__ring" />
              {site.pois.map((p) => (
                <a href={`${pageHref(mapPage!.path)}#poi-${p.id}`} class="menu__poi" aria-label={p.name}>
                  <circle cx={50 + p.position[0] * 0.8} cy={50 + p.position[1] * 0.8} r="1.6" />
                  <text x={50 + p.position[0] * 0.8 + 3} y={50 + p.position[1] * 0.8 + 1}>{p.name}</text>
                </a>
              ))}
            </svg>
            <a class="btn" href={pageHref(mapPage!.path)}><span>{t('enterMap')}</span><span class="btn__arrow" aria-hidden="true"></span></a>
          </div>
        ) : (
          <div class="menu__preview media" aria-hidden="true">
            <img src={site.hero.image.src} alt="" data-menu-preview loading="lazy" />
          </div>
        )}
      </aside>
    </div>
    <div class="menu__foot wrap">
      <ul role="list" class="menu__secondary">
        {secondary.map((i) => <li><a class="link" href={i.href}>{i.label}</a></li>)}
      </ul>
      <ul role="list" class="menu__contacts">
        {site.contacts.email && <li><a class="link" href={`mailto:${site.contacts.email}`}>{site.contacts.email}</a></li>}
        {site.contacts.phone && <li><a class="link" href={`tel:${site.contacts.phone.replace(/\s/g, '')}`}>{site.contacts.phone}</a></li>}
        {site.alternates.map((a) => <li><a class="link" href={a.href} hreflang={a.locale}>{a.label}</a></li>)}
      </ul>
      {site.collection && (
        <div class="menu__collection">
          <p class="micro muted">{site.collection.label}</p>
          <ul role="list">{site.collection.properties.map((p) => <li><a href={p.href} aria-current={p.current ? 'true' : undefined}>{p.name}<span class="muted"> — {p.location}</span></a></li>)}</ul>
        </div>
      )}
      {bookingEnabled && bookingHref && <a class="btn" href={bookingHref} data-book-open><span>{site.booking.label}</span><span class="btn__arrow" aria-hidden="true"></span></a>}
    </div>
  </div>
</div>

<style>
  .menu { position: fixed; inset: 0; z-index: 1000; color: var(--c-dark-ink); --c-ink: var(--c-dark-ink); --c-ink-soft: var(--c-dark-soft); --c-line: rgb(255 255 255 / 0.16); }
  .menu[hidden] { display: none; }
  .menu__veil { position: absolute; inset: 0; background: rgb(0 0 0 / 0.3); }
  .menu__panel {
    position: absolute; inset: 0; background: var(--c-dark); display: grid; grid-template-rows: auto 1fr auto;
    overflow-y: auto; clip-path: inset(0 0 100% 0); transition: clip-path 1s var(--ease-glide);
  }
  .menu.is-open .menu__panel { clip-path: inset(0 0 0 0); }
  .menu__top { display: flex; justify-content: space-between; align-items: center; height: var(--header-h); }
  .menu__brand { font-family: var(--f-display); letter-spacing: 0.3em; }
  .menu__close { display: inline-flex; gap: 14px; align-items: center; font-size: var(--fs-micro); letter-spacing: 0.2em; text-transform: uppercase; min-height: 44px; }
  .menu__x { width: 22px; height: 22px; position: relative; }
  .menu__x::before, .menu__x::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: currentColor; transform: rotate(45deg); }
  .menu__x::after { transform: rotate(-45deg); }
  .menu__body { display: grid; grid-template-columns: 1.3fr 1fr; gap: 6vw; align-items: center; padding-block: 3vh 5vh; }
  .menu__nav ol { display: grid; gap: 0.2em; }
  .menu__nav a { display: flex; align-items: baseline; gap: 1.2rem; font-family: var(--f-display); font-variation-settings: var(--fv-display); font-weight: var(--fw-display); text-transform: var(--display-case); letter-spacing: var(--display-tracking); font-size: clamp(2.2rem, 5.4vw, 5.2rem); line-height: 1.02; color: var(--c-dark-soft); transition: color 0.5s, transform 0.7s var(--ease-out); }
  .menu__nav a:hover, .menu__nav a:focus-visible, .menu__nav a[aria-current='page'] { color: var(--c-dark-ink); transform: translateX(14px); }
  .menu__num { font-family: var(--f-body); font-size: var(--fs-micro); letter-spacing: 0.14em; opacity: 0.6; }
  .menu__nav li { opacity: 0; transform: translateY(30px); transition: opacity 0.8s var(--ease-out), transform 1s var(--ease-out); }
  .menu.is-open .menu__nav li { opacity: 1; transform: none; }
  .menu.is-open .menu__nav li:nth-child(2) { transition-delay: 0.05s; } .menu.is-open .menu__nav li:nth-child(3) { transition-delay: 0.1s; }
  .menu.is-open .menu__nav li:nth-child(4) { transition-delay: 0.15s; } .menu.is-open .menu__nav li:nth-child(5) { transition-delay: 0.2s; }
  .menu.is-open .menu__nav li:nth-child(6) { transition-delay: 0.25s; } .menu.is-open .menu__nav li:nth-child(n+7) { transition-delay: 0.3s; }
  .menu__preview { aspect-ratio: 4 / 5; max-height: 62vh; }
  .menu__preview img { transition: opacity 0.6s, transform 1.4s var(--ease-out); }
  .menu__map { display: grid; gap: 18px; }
  .menu__svg { width: 100%; max-width: 460px; overflow: visible; }
  .menu__land { fill: rgb(255 255 255 / 0.04); stroke: rgb(255 255 255 / 0.2); stroke-width: 0.2; }
  .menu__ring { fill: none; stroke: rgb(255 255 255 / 0.1); stroke-width: 0.2; stroke-dasharray: 0.6 1.2; }
  .menu__poi circle { fill: var(--c-accent); transition: r 0.4s; }
  .menu__poi text { font-size: 2.6px; fill: var(--c-dark-ink); opacity: 0.55; font-family: var(--f-body); letter-spacing: 0.04em; transition: opacity 0.3s; }
  .menu__poi:hover text, .menu__poi:focus text { opacity: 1; }
  .menu__poi:hover circle { r: 2.4; }
  .menu__foot { display: flex; flex-wrap: wrap; gap: 24px 56px; align-items: flex-end; padding-block: 28px 40px; border-top: 1px solid var(--c-line); font-size: var(--fs-small); }
  .menu__foot ul { display: grid; gap: 6px; }
  .menu__foot > .btn { margin-left: auto; }
  .menu__collection ul { margin-top: 8px; }
  @media (max-width: 860px) {
    .menu__body { grid-template-columns: 1fr; align-items: start; }
    .menu__aside { display: none; }
    .menu__nav a { font-size: clamp(2rem, 10vw, 3rem); }
    .menu__foot > .btn { margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .menu__panel { clip-path: none; } }
</style>
