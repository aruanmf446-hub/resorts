---
import Base from '../layouts/Base.astro';
import { site, t } from '../lib/context';
---
<Base title="404" noindex>
  <section class="section nf" data-theme="dark">
    <div class="wrap nf__in">
      <p class="eyebrow">404</p>
      <h1 class="t-xxl">{t('notFound')}</h1>
      <a class="btn" href="/"><span>{site.identity.shortName}</span><span class="btn__arrow" aria-hidden="true"></span></a>
    </div>
  </section>
</Base>
<style>.nf { min-height: 100svh; display: grid; align-items: center; } .nf__in { display: grid; gap: 28px; justify-items: start; } .nf h1 { max-width: 16ch; }</style>
