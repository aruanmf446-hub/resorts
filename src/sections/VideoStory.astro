---
import type { SectionConfig, Video } from '../config/schema';
import { site } from '../lib/context';
import Section from './Section.astro';
import Heading from '../components/Heading.astro';
interface Props { section: SectionConfig }
const { section } = Astro.props;
const c = section.content as { eyebrow?: string; title: string; intro?: string; text?: string; video: Video };
const v = c.video;
---
<Section section={section} defaultTheme="dark">
  <div class="wrap vs">
    <div class="vs__head"><Heading eyebrow={c.eyebrow} title={c.title} intro={c.intro} size="l" />{c.text && <p class="prose">{c.text}</p>}</div>
    <div class="media vs__player" data-reveal="mask">
      <video controls playsinline preload="none" poster={v.poster.src} aria-label={v.label} width="1600" height="900">
        {v.webm && <source src={v.webm} type="video/webm" />}
        <source src={v.src} type="video/mp4" />
        {v.captions && <track kind="captions" src={v.captions} srclang={v.captionsLang ?? site.locale} label={v.label} default />}
      </video>
    </div>
  </div>
</Section>
<style>
  .vs { display: grid; gap: 40px; }
  .vs__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .vs__player { aspect-ratio: 16 / 9; }
  .vs__player video { width: 100%; height: 100%; object-fit: cover; background: #000; }
</style>
