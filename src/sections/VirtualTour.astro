---
import type { SectionConfig, Image } from '../config/schema';
import Section from './Section.astro';
import Heading from '../components/Heading.astro';
import Img from '../components/Img.astro';
interface Props { section: SectionConfig }
const { section } = Astro.props;
const c = section.content as { eyebrow?: string; title: string; intro?: string; panorama: string; fallback: Image; label: string };
---
<Section section={section} defaultTheme="dark">
  <div class="wrap vt">
    <Heading eyebrow={c.eyebrow} title={c.title} intro={c.intro} size="l" />
    <div class="vt__stage" data-panorama data-src={c.panorama} data-state="loading">
      <div class="media vt__fallback"><Img image={c.fallback} /></div>
      <canvas tabindex="0" role="img" aria-label={c.label}></canvas>
      <span class="vt__badge micro" aria-hidden="true">360°</span>
    </div>
  </div>
</Section>
<script>import '../scripts/panorama';</script>
<style>
  .vt { display: grid; gap: 36px; }
  .vt__stage { position: relative; height: min(76vh, 760px); min-height: 380px; border-radius: var(--radius); overflow: hidden; }
  .vt__fallback { position: absolute; inset: 0; }
  .vt__stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1s; cursor: grab; touch-action: none; }
  .vt__stage[data-state='ready'] canvas { opacity: 1; }
  .vt__badge { position: absolute; left: 20px; top: 20px; padding: 8px 14px; border: 1px solid rgb(255 255 255 / 0.5); border-radius: 999px; color: #fff; }
</style>
