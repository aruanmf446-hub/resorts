---
import type { SectionConfig } from '../config/schema';
import { site, t } from '../lib/context';
import Section from './Section.astro';
import Heading from '../components/Heading.astro';
import Img from '../components/Img.astro';
import Btn from '../components/Btn.astro';
interface Props { section: SectionConfig }
const { section } = Astro.props;
const c = section.content as { eyebrow?: string; title: string; intro?: string; slugs?: string[]; cta?: { label: string; href: string } };
const venues = c.slugs ? site.dining.filter((d) => c.slugs!.includes(d.slug)) : site.dining;
const index = section.variant === 'index';
---
{venues.length > 0 && (
  <Section section={section}>
    <div class="wrap gs">
      <div class="gs__head">
        <Heading eyebrow={c.eyebrow} title={c.title} intro={c.intro} size={index ? 'l' : 'xl'} />
        {c.cta && <Btn href={c.cta.href} label={c.cta.label} />}
      </div>
      <div class:list={['gs__list', index && 'gs__list--index']}>
        {venues.map((v, i) => (
          <article class:list={['gs__venue', i % 2 && 'gs__venue--alt']} id={v.slug}>
            <div class="media gs__media" data-reveal="mask"><Img image={v.cover} sizes="(max-width: 900px) 100vw, 55vw" /></div>
            <div class="gs__text">
              <p class="micro muted">{v.kind}{v.cuisine && ` · ${v.cuisine}`}</p>
              <h3 class="t-l" data-reveal="lines">{v.name}</h3>
              <p class="lede">{v.summary}</p>
              {index && v.description.map((p) => <p class="prose">{p}</p>)}
              {v.hours.length > 0 && (
                <dl class="gs__hours">
                  {v.hours.map((h) => <div><dt class="micro muted">{h.label}</dt><dd class="num">{h.value}</dd></div>)}
                </dl>
              )}
              <div class="gs__ctas">
                {v.cta && <Btn href={v.cta.href} label={v.cta.label} />}
                {index && v.menuPdf && <a class="link small" href={v.menuPdf} target="_blank" rel="noopener">{t('menuPdf')} ↗</a>}
                {v.location && <span class="micro muted">{t('location')}: {v.location}</span>}
              </div>
              {index && v.gallery.length > 1 && (
                <div class="gs__thumbs">{v.gallery.slice(1, 3).map((g) => <div class="media"><Img image={g} sizes="20vw" /></div>)}</div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </Section>
)}
<style>
  .gs { display: grid; gap: clamp(48px, 7vw, 110px); }
  .gs__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .gs__list { display: grid; gap: clamp(64px, 9vw, 150px); }
  .gs__venue { display: grid; grid-template-columns: 7fr 5fr; gap: clamp(24px, 5vw, 88px); align-items: center; }
  .gs__venue--alt { grid-template-columns: 5fr 7fr; }
  .gs__venue--alt .gs__media { order: 2; }
  .gs__media { aspect-ratio: 4 / 3; }
  .gs__text { display: grid; gap: 18px; justify-items: start; }
  .gs__hours { display: flex; flex-wrap: wrap; gap: 14px 36px; border-top: 1px solid var(--c-line); padding-top: 18px; width: 100%; }
  .gs__ctas { display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: center; }
  .gs__thumbs { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; width: 100%; }
  .gs__thumbs .media { aspect-ratio: 1; }
  @media (max-width: 900px) { .gs__venue, .gs__venue--alt { grid-template-columns: 1fr; } .gs__venue--alt .gs__media { order: 0; } }
</style>
