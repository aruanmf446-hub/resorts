---
/** Shared by: weddings, corporate, events, packages. No prices are rendered. */
import type { SectionConfig, Image } from '../config/schema';
import Section from './Section.astro';
import Heading from '../components/Heading.astro';
import Img from '../components/Img.astro';
import Btn from '../components/Btn.astro';
interface Props { section: SectionConfig }
const { section } = Astro.props;
const c = section.content as { eyebrow?: string; title: string; intro?: string; image: Image; items: { title: string; text?: string }[]; cta?: { label: string; href: string }; note?: string };
---
<Section section={section}>
  <div class="wrap of">
    <div class="media of__img" data-reveal="mask"><Img image={c.image} sizes="100vw" /></div>
    <div class="of__card">
      <Heading eyebrow={c.eyebrow} title={c.title} intro={c.intro} size="l" />
      {c.items.length > 0 && <ul class="of__items" role="list">{c.items.map((i) => <li><span class="t-s">{i.title}</span>{i.text && <span class="small muted">{i.text}</span>}</li>)}</ul>}
      {c.cta && <Btn href={c.cta.href} label={c.cta.label} />}
      {c.note && <p class="micro muted">{c.note}</p>}
    </div>
  </div>
</Section>
<style>
  .of { position: relative; display: grid; grid-template-columns: repeat(12, 1fr); align-items: center; }
  .of__img { grid-column: 1 / span 8; grid-row: 1; aspect-ratio: 16 / 10; }
  .of__card { grid-column: 7 / -1; grid-row: 1; background: var(--section-bg, var(--c-bg)); padding: clamp(28px, 4vw, 64px); display: grid; gap: 26px; justify-items: start; position: relative; z-index: 1; border-radius: var(--radius); box-shadow: 0 30px 80px rgb(0 0 0 / 0.08); }
  .of__items { display: grid; gap: 12px; width: 100%; }
  .of__items li { display: grid; gap: 2px; border-top: 1px solid var(--c-line); padding-top: 12px; }
  @media (max-width: 900px) { .of__img, .of__card { grid-column: 1 / -1; grid-row: auto; } .of__card { margin: -60px 16px 0; } }
</style>
