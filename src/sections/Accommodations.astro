---
import type { SectionConfig } from '../config/schema';
import { site, t, link } from '../lib/context';
import Section from './Section.astro';
import Heading from '../components/Heading.astro';
import Img from '../components/Img.astro';
import Btn from '../components/Btn.astro';
interface Props { section: SectionConfig }
const { section } = Astro.props;
const c = section.content as { eyebrow?: string; title: string; intro?: string; slugs?: string[]; cta?: { label: string; href: string } };
const stays = c.slugs ? c.slugs.map((s) => site.stays.find((x) => x.slug === s)).filter((x) => !!x) : section.variant === 'index' ? site.stays : site.stays.filter((s) => s.featured).concat(site.stays.filter((s) => !s.featured)).slice(0, 3);
const index = section.variant === 'index';
const spec = (s: (typeof stays)[number]) => [
  `${s.capacity.adults + s.capacity.children} ${t('capacity').toLowerCase()}`,
  s.area && `${s.area.value} ${s.area.unit}`,
  s.view,
].filter(Boolean);
---
{stays.length > 0 && (
  <Section section={section}>
    <div class="wrap ac">
      <div class="ac__head">
        <Heading eyebrow={c.eyebrow} title={c.title} intro={c.intro} size={index ? 'l' : 'xl'} />
        {c.cta && <Btn href={c.cta.href} label={c.cta.label} />}
      </div>
      {index ? (
        <ol class="ac__index" role="list">
          {stays.map((s, i) => (
            <li class="ac__row" data-reveal="rise">
              <a href={link.stay(s.slug) ?? '#'} class="ac__row-link">
                <span class="media ac__row-media"><Img image={s.cover} sizes="(max-width: 900px) 100vw, 40vw" /></span>
                <span class="ac__row-text">
                  <span class="micro muted">{String(i + 1).padStart(2, '0')} · {s.category}</span>
                  <span class="t-l">{s.name}</span>
                  <span class="muted">{s.tagline}</span>
                  <span class="ac__specs micro">{spec(s).map((x) => <span>{x}</span>)}</span>
                  <span class="btn"><span>{t('discover')}</span><span class="btn__arrow" aria-hidden="true"></span></span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <div class="ac__editorial">
          {stays.map((s, i) => (
            <article class:list={['ac__item', `ac__item--${i % 3}`]}>
              <a href={link.stay(s.slug) ?? '#'} class="ac__link" aria-label={s.name}>
                <div class="media ac__media" data-reveal="mask"><div class="ac__par" data-parallax="0.14"><Img image={s.cover} sizes="(max-width: 900px) 100vw, 60vw" /></div></div>
              </a>
              <div class="ac__text">
                <p class="micro muted">{String(i + 1).padStart(2, '0')} — {s.category}</p>
                <h3 class="t-l" data-reveal="lines"><a href={link.stay(s.slug) ?? '#'}>{s.name}</a></h3>
                <p class="muted" data-reveal="fade">{s.tagline}</p>
                <p class="ac__specs micro">{spec(s).map((x) => <span>{x}</span>)}</p>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </Section>
)}
<style>
  .ac { display: grid; gap: clamp(48px, 7vw, 120px); }
  .ac__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; }
  .ac__head :global(.heading) { max-width: 46rem; }
  .ac__specs { display: flex; flex-wrap: wrap; gap: 8px 20px; letter-spacing: 0.14em; }
  .ac__specs span + span::before { content: '·'; margin-right: 20px; opacity: 0.5; }
  .ac__editorial { display: grid; gap: clamp(72px, 12vw, 200px); }
  .ac__item { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: clamp(12px, 2vw, 32px); align-items: end; }
  .ac__media { aspect-ratio: 16 / 10; }
  .ac__par { position: absolute; inset: -10% 0; }
  .ac__par :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ac__text { display: grid; gap: 14px; padding-bottom: 8px; }
  .ac__item--0 .ac__link { grid-column: 1 / span 8; } .ac__item--0 .ac__text { grid-column: 10 / -1; }
  .ac__item--1 .ac__link { grid-column: 5 / -1; grid-row: 1; } .ac__item--1 .ac__text { grid-column: 1 / span 3; grid-row: 1; }
  .ac__item--1 .ac__media { aspect-ratio: 4 / 5; max-height: 86vh; }
  .ac__item--2 .ac__link { grid-column: 2 / span 10; } .ac__item--2 .ac__text { grid-column: 2 / span 6; padding-top: 28px; }
  .ac__index { display: grid; gap: 0; border-top: 1px solid var(--c-line); }
  .ac__row { border-bottom: 1px solid var(--c-line); }
  .ac__row-link { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(24px, 4vw, 72px); padding-block: clamp(28px, 4vw, 56px); align-items: center; }
  .ac__row-media { aspect-ratio: 3 / 2; }
  .ac__row-media :global(img) { transition: transform 1.4s var(--ease-out); }
  .ac__row-link:hover .ac__row-media :global(img) { transform: scale(1.04); }
  .ac__row-text { display: grid; gap: 14px; justify-items: start; }
  @media (max-width: 900px) {
    .ac__item { display: grid; grid-template-columns: 1fr; gap: 20px; }
    .ac__item .ac__link, .ac__item .ac__text { grid-column: 1 !important; grid-row: auto !important; }
    .ac__row-link { grid-template-columns: 1fr; }
  }
</style>
