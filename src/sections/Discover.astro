---
import type { SectionConfig, Image } from '../config/schema';
import { link } from '../lib/context';
import Section from './Section.astro';
import Heading from '../components/Heading.astro';
import Img from '../components/Img.astro';
interface Props { section: SectionConfig }
const { section } = Astro.props;
const c = section.content as { eyebrow?: string; title: string; intro?: string; areas: { title: string; text: string; image: Image; link?: string }[] };
---
<Section section={section}>
  <div class="wrap dc" data-discover>
    <Heading eyebrow={c.eyebrow} title={c.title} intro={c.intro} size="xl" />
    <div class="dc__body">
      <ol class="dc__list" role="list">
        {c.areas.map((a, i) => {
          const href = link.resolve(a.link);
          const Tag = href ? 'a' : 'div';
          return (
            <li data-reveal="fade">
              <Tag class="dc__item" href={href ?? undefined} data-index={i} tabindex={href ? undefined : 0}>
                <span class="dc__num micro">{String(i + 1).padStart(2, '0')}</span>
                <span class="dc__title t-l">{a.title}</span>
                <span class="dc__text muted">{a.text}</span>
                <span class="dc__thumb media"><Img image={a.image} sizes="90vw" /></span>
              </Tag>
            </li>
          );
        })}
      </ol>
      <div class="dc__visual" aria-hidden="true">
        {c.areas.map((a, i) => <div class:list={['dc__img media', i === 0 && 'is-active']} data-img={i}><Img image={{ ...a.image, alt: '' }} sizes="45vw" /></div>)}
      </div>
    </div>
  </div>
</Section>
<script>
  document.querySelectorAll<HTMLElement>('[data-discover]').forEach((root) => {
    const imgs = root.querySelectorAll<HTMLElement>('[data-img]');
    root.querySelectorAll<HTMLElement>('.dc__item').forEach((it) => {
      const on = () => imgs.forEach((im) => im.classList.toggle('is-active', im.dataset.img === it.dataset.index));
      it.addEventListener('mouseenter', on);
      it.addEventListener('focus', on);
    });
  });
</script>
<style>
  .dc { display: grid; gap: clamp(48px, 6vw, 96px); }
  .dc__body { display: grid; grid-template-columns: 1.1fr 1fr; gap: 6vw; align-items: start; }
  .dc__list { border-top: 1px solid var(--c-line); }
  .dc__item { display: grid; grid-template-columns: 3rem 1fr; column-gap: 16px; row-gap: 6px; padding: 28px 0; border-bottom: 1px solid var(--c-line); transition: padding 0.6s var(--ease-out), color 0.4s; }
  .dc__item:hover, .dc__item:focus-visible { padding-left: 18px; }
  .dc__num { grid-row: span 2; padding-top: 0.8em; }
  .dc__thumb { display: none; }
  .dc__visual { position: sticky; top: calc(var(--header-h) + 24px); aspect-ratio: 4 / 5; }
  .dc__img { position: absolute; inset: 0; opacity: 0; transform: scale(1.04); transition: opacity 0.9s var(--ease-calm), transform 1.4s var(--ease-out); }
  .dc__img.is-active { opacity: 1; transform: none; }
  @media (max-width: 900px) {
    .dc__body { grid-template-columns: 1fr; }
    .dc__visual { display: none; }
    .dc__thumb { display: block; grid-column: 1 / -1; aspect-ratio: 16 / 10; margin-top: 16px; }
  }
</style>
