---
/** Shared by: sustainability, culture. */
import type { SectionConfig, Image } from '../config/schema';
import Section from './Section.astro';
import Heading from '../components/Heading.astro';
import Img from '../components/Img.astro';
interface Props { section: SectionConfig }
const { section } = Astro.props;
const c = section.content as { eyebrow?: string; title: string; intro?: string; image?: Image; items: { title: string; text?: string }[] };
---
<Section section={section}>
  <div class="wrap pi">
    <Heading eyebrow={c.eyebrow} title={c.title} intro={c.intro} size="xl" />
    {c.image && <div class="media pi__img" data-reveal="mask"><Img image={c.image} /></div>}
    <ol class="pi__list" role="list" data-reveal="stagger">
      {c.items.map((i, n) => <li><span class="pi__n t-xl num">{String(n + 1).padStart(2, '0')}</span><h3 class="t-s">{i.title}</h3>{i.text && <p class="small muted">{i.text}</p>}</li>)}
    </ol>
  </div>
</Section>
<style>
  .pi { display: grid; gap: clamp(48px, 6vw, 96px); }
  .pi__img { aspect-ratio: 21 / 9; }
  .pi__list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 40px clamp(24px, 3vw, 48px); }
  .pi__list li { display: grid; gap: 14px; align-content: start; border-top: 1px solid var(--c-line); padding-top: 22px; }
  .pi__n { color: var(--c-accent); opacity: 0.85; }
</style>
